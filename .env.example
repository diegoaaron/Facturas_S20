# URL base del túnel de tu backend Gemma (sin la ruta final), usada solo por Vite para
# reenviar las peticiones y evitar problemas de CORS en el navegador.
GEMMA_TUNNEL_ORIGIN=https://tu-tunel.trycloudflare.com

# Ruta que llama el frontend (queda fija, no la cambies): se sirve desde el propio
# servidor de Vite, que la reenvía a GEMMA_TUNNEL_ORIGIN + /extraer.
VITE_GEMMA_ENDPOINT_URL=/api/extraer
