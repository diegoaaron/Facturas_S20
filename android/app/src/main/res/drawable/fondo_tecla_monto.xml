<!-- Tecla del teclado de montos (P13). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/color_tecla_clara"/>
            <stroke android:width="1dp" android:color="@color/color_borde"/>
            <corners android:radius="@dimen/radio_tarjeta"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/color_superficie"/>
            <stroke android:width="1dp" android:color="@color/color_borde"/>
            <corners android:radius="@dimen/radio_tarjeta"/>
        </shape>
    </item>
</selector>
