<?xml version="1.0" encoding="utf-8"?>
<!-- P17 Historial y cierre (prototipo pantalla_17_historial_y_cierre.png): meses abiertos con «Cerrar el
     mes», meses cerrados, acumulado del año y exportar. -->
<LinearLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/color_fondo"
        android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/barra"
            style="@style/Widget.FacturasS20.BarraSuperior.Atras"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:title="@string/historial_titulo"/>

    <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

        <androidx.core.widget.NestedScrollView
                android:id="@+id/desplazamiento"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingBottom="40dp"
                android:visibility="invisible"
                tools:visibility="visible">

            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/margen">

                <LinearLayout
                        android:id="@+id/lista"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"/>

                <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp">

                    <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="@dimen/relleno_tarjeta">

                        <TextView
                                android:id="@+id/texto_anio"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:accessibilityHeading="true"
                                android:textAppearance="@style/Texto.FacturasS20.Dato"
                                android:textStyle="bold"
                                tools:text="Acumulado de 2026"/>

                        <TextView
                                android:id="@+id/texto_compras_anio"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:textAppearance="@style/Texto.FacturasS20.Secundario"
                                tools:text="Compras S/ 34,212.60 de S/ 96,000 (tope anual)"/>

                        <pe.facturass20.ui.comun.BarraLimiteView
                                android:id="@+id/barra_anio"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"/>

                        <TextView
                                android:id="@+id/texto_ventas_anio"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textAppearance="@style/Texto.FacturasS20.Secundario"
                                tools:text="Ventas registradas: S/ 30,100.00"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp">

                    <LinearLayout
                            android:id="@+id/enlaces"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"/>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/progreso"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:indeterminate="true"
                android:visibility="gone"
                app:indicatorColor="@color/color_primario"/>
    </FrameLayout>
</LinearLayout>
