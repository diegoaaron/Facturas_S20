<?xml version="1.0" encoding="utf-8"?>
<!-- Un mes abierto en P17: tarjeta verde con resumen, «Ver facturas» y «Cerrar el mes». -->
<LinearLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:background="@drawable/fondo_tarjeta_ok"
        android:orientation="vertical"
        android:padding="@dimen/relleno_tarjeta">

    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

        <TextView
                android:id="@+id/texto_mes"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:accessibilityHeading="true"
                android:textAppearance="@style/Texto.FacturasS20.Titulo"
                tools:text="Septiembre 2026"/>

        <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/fondo_etiqueta_blanca"
                android:paddingStart="12dp"
                android:paddingTop="4dp"
                android:paddingEnd="12dp"
                android:paddingBottom="4dp"
                android:text="@string/historial_abierto"
                android:textAppearance="@style/Texto.FacturasS20.Etiqueta"
                android:textColor="@color/color_acento_oscuro"/>
    </LinearLayout>

    <TextView
            android:id="@+id/texto_montos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textAppearance="@style/Texto.FacturasS20.Secundario"
            tools:text="Compras S/ 4,120.50 · Ventas S/ 3,900.00"/>

    <TextView
            android:id="@+id/texto_categoria"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textAppearance="@style/Texto.FacturasS20.Secundario"
            tools:text="Categoría 1 · cuota S/ 20"/>

    <com.google.android.material.button.MaterialButton
            android:id="@+id/boton_cerrar"
            style="@style/Widget.FacturasS20.Boton.Grande"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/historial_cerrar"/>

    <com.google.android.material.button.MaterialButton
            android:id="@+id/boton_facturas"
            style="@style/Widget.FacturasS20.Boton.Texto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/historial_ver_facturas"/>
</LinearLayout>
