<?xml version="1.0" encoding="utf-8"?>
<!-- Un grupo de campos en P07: círculo punteado mientras se lee y check verde cuando está listo. -->
<LinearLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="44dp"
        android:orientation="horizontal">

    <ImageView
            android:id="@+id/icono"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_circulo_vacio"
            app:tint="@color/color_borde"/>

    <TextView
            android:id="@+id/texto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:textAppearance="@style/Texto.FacturasS20.Dato"
            android:textSize="18sp"
            tools:text="Proveedor y RUC"/>
</LinearLayout>
