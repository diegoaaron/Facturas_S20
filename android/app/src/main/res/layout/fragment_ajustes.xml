<?xml version="1.0" encoding="utf-8"?>
<!-- P18 Ajustes (prototipo pantalla_18_ajustes_modelo_y.png): secciones en tarjetas; las filas las arma
     AjustesFragment con ui.comun.Filas. -->
<LinearLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/color_fondo"
        android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/barra"
            style="@style/Widget.FacturasS20.BarraSuperior"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:title="@string/p18_titulo"/>

    <androidx.core.widget.NestedScrollView
            android:id="@+id/desplazamiento"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="40dp"
            android:visibility="invisible"
            tools:visibility="visible">

        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/margen">

            <TextView
                    style="@style/Texto.FacturasS20.Seccion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:accessibilityHeading="true"
                    android:text="@string/ajustes_negocio"/>

            <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp">

                <LinearLayout
                        android:id="@+id/seccion_negocio"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"/>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                    style="@style/Texto.FacturasS20.Seccion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginTop="20dp"
                    android:accessibilityHeading="true"
                    android:text="@string/ajustes_seguridad"/>

            <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp">

                <LinearLayout
                        android:id="@+id/seccion_seguridad"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"/>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                    style="@style/Texto.FacturasS20.Seccion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginTop="20dp"
                    android:accessibilityHeading="true"
                    android:text="@string/ajustes_lector"/>

            <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp">

                <LinearLayout
                        android:id="@+id/seccion_lector"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"/>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                    style="@style/Texto.FacturasS20.Seccion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginTop="20dp"
                    android:accessibilityHeading="true"
                    android:text="@string/ajustes_parametros"/>

            <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp">

                <LinearLayout
                        android:id="@+id/seccion_parametros"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"/>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                    style="@style/Texto.FacturasS20.Seccion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginTop="20dp"
                    android:accessibilityHeading="true"
                    android:text="@string/ajustes_datos"/>

            <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp">

                <LinearLayout
                        android:id="@+id/seccion_datos"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"/>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                    android:id="@+id/texto_version"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:gravity="center"
                    android:textAppearance="@style/Texto.FacturasS20.Ayuda"
                    tools:text="Facturas S20 · versión 1.0"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
