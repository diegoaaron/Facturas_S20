<?xml version="1.0" encoding="utf-8"?>
<!-- P11 Facturas del mes (prototipo pantalla_11_facturas_del_mes.png): filtros, búsqueda, lista por semana
     y el total del mes abajo, sobre la barra inferior. -->
<LinearLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/color_fondo"
        android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/barra"
            style="@style/Widget.FacturasS20.BarraSuperior"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:menu="@menu/menu_lista_facturas"
            tools:title="Facturas de septiembre"/>

    <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/campo_busqueda"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margen"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="@dimen/margen"
            android:hint="@string/facturas_buscar_ayuda"
            android:visibility="gone"
            app:endIconMode="clear_text"
            app:startIconDrawable="@drawable/ic_buscar">

        <com.google.android.material.textfield.TextInputEditText
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:textStyle="normal"/>
    </com.google.android.material.textfield.TextInputLayout>

    <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

        <com.google.android.material.chip.ChipGroup
                android:id="@+id/filtros"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/margen"
                android:paddingTop="8dp"
                android:paddingEnd="@dimen/margen"
                app:selectionRequired="true"
                app:singleLine="true"
                app:singleSelection="true">

            <com.google.android.material.chip.Chip
                    android:id="@+id/filtro_todas"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    tools:text="Todas (12)"/>

            <com.google.android.material.chip.Chip
                    android:id="@+id/filtro_ia"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="Leídas por IA"/>

            <com.google.android.material.chip.Chip
                    android:id="@+id/filtro_manuales"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="Manuales"/>

            <com.google.android.material.chip.Chip
                    android:id="@+id/filtro_anuladas"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="Anuladas"/>
        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

        <androidx.core.widget.NestedScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent">

            <LinearLayout
                    android:id="@+id/lista"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/margen"
                    android:paddingEnd="@dimen/margen"
                    android:paddingBottom="16dp"/>
        </androidx.core.widget.NestedScrollView>

        <LinearLayout
                android:id="@+id/vacio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="@dimen/margen_amplio"
                android:visibility="gone">

            <ImageView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_facturas"
                    app:tint="@color/color_inactivo"/>

            <TextView
                    android:id="@+id/texto_vacio"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:textAppearance="@style/Texto.FacturasS20.Dato"
                    android:textStyle="bold"
                    tools:text="@string/p04_sin_facturas"/>

            <TextView
                    android:id="@+id/texto_vacio_ayuda"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:text="@string/p04_sin_facturas_ayuda"
                    android:textAppearance="@style/Texto.FacturasS20.Secundario"/>
        </LinearLayout>

        <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/progreso"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:indeterminate="true"
                android:visibility="gone"
                app:indicatorColor="@color/color_primario"/>
    </FrameLayout>

    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/color_ok_claro"
            android:gravity="center_vertical"
            android:minHeight="64dp"
            android:orientation="horizontal"
            android:paddingStart="@dimen/margen"
            android:paddingEnd="@dimen/margen"
            android:paddingBottom="36dp"
            android:paddingTop="12dp">

        <TextView
                android:id="@+id/texto_total_etiqueta"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textAppearance="@style/Texto.FacturasS20.Dato"
                tools:text="Total del mes (12 facturas)"/>

        <TextView
                android:id="@+id/texto_total"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/Texto.FacturasS20.Titulo"
                android:textColor="@color/color_primario"
                tools:text="S/ 4,120.50"/>
    </LinearLayout>
</LinearLayout>
