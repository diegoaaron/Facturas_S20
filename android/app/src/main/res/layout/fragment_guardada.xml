<?xml version="1.0" encoding="utf-8"?>
<!-- P10 Guardada (prototipo pantalla_10_factura_guardada.png): confirmación, importe agregado y cómo
     quedó el mes; los botones abajo. -->
<LinearLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/color_superficie"
        android:orientation="vertical">

    <androidx.core.widget.NestedScrollView
            android:id="@+id/desplazamiento"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:visibility="invisible"
            tools:visibility="visible">

        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingStart="@dimen/margen_amplio"
                android:paddingTop="48dp"
                android:paddingEnd="@dimen/margen_amplio"
                android:paddingBottom="16dp">

            <FrameLayout
                    android:layout_width="128dp"
                    android:layout_height="128dp"
                    android:background="@drawable/fondo_circulo_ok_claro">

                <ImageView
                        android:layout_width="88dp"
                        android:layout_height="88dp"
                        android:layout_gravity="center"
                        android:background="@drawable/fondo_circulo_ok"
                        android:importantForAccessibility="no"
                        android:padding="22dp"
                        android:src="@drawable/ic_check"
                        app:tint="@color/color_superficie"/>
            </FrameLayout>

            <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:accessibilityHeading="true"
                    android:text="@string/p10_titulo"
                    android:textAppearance="@style/Texto.FacturasS20.TituloGrande"
                    android:textSize="30sp"/>

            <TextView
                    android:id="@+id/texto_documento"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:textAppearance="@style/Texto.FacturasS20.Secundario"
                    tools:text="Distribuidora Andina · F001-004821"/>

            <TextView
                    android:id="@+id/texto_importe"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textAppearance="@style/Texto.FacturasS20.Monto"
                    android:textColor="@color/color_acento_oscuro"
                    android:textSize="36sp"
                    tools:text="+ S/ 1 450,00"/>

            <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp">

                <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/relleno_tarjeta">

                    <TextView
                            android:id="@+id/texto_compras_mes"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/Texto.FacturasS20.Secundario"
                            tools:text="Compras de septiembre"/>

                    <TextView
                            android:id="@+id/texto_compras"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/Texto.FacturasS20.Monto"
                            android:textColor="@color/color_texto"
                            tools:text="S/ 4 120,50"/>

                    <pe.facturass20.ui.comun.BarraLimiteView
                            android:id="@+id/barra_limite"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"/>

                    <TextView
                            android:id="@+id/texto_aviso"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:drawablePadding="10dp"
                            android:gravity="center_vertical"
                            android:textAppearance="@style/Texto.FacturasS20.Dato"
                            android:textStyle="bold"
                            app:drawableStartCompat="@drawable/ic_alerta"
                            tools:text="Superó el 80 % del límite de la categoría 1"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/margen_amplio"
            android:paddingEnd="@dimen/margen_amplio"
            android:paddingBottom="16dp">

        <com.google.android.material.button.MaterialButton
                android:id="@+id/boton_escanear_otra"
                style="@style/Widget.FacturasS20.Boton.Grande.Acento"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/guardada_escanear_otra"
                app:icon="@drawable/ic_escanear"/>

        <com.google.android.material.button.MaterialButton
                android:id="@+id/boton_inicio"
                style="@style/Widget.FacturasS20.Boton.Contorno"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/guardada_ir_inicio"/>
    </LinearLayout>
</LinearLayout>
