<?xml version="1.0" encoding="utf-8"?>
<!-- Una comprobación del teléfono en P03: ✓ o ✗, qué se mide y el valor. -->
<LinearLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="48dp"
        android:orientation="horizontal">

    <ImageView
            android:id="@+id/icono"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:importantForAccessibility="no"
            tools:src="@drawable/ic_check_circulo"/>

    <TextView
            android:id="@+id/texto_etiqueta"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:textAppearance="@style/Texto.FacturasS20.Dato"
            tools:text="Memoria del teléfono"/>

    <TextView
            android:id="@+id/texto_valor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:gravity="end"
            android:textAppearance="@style/Texto.FacturasS20.Secundario"
            tools:text="6 GB"/>
</LinearLayout>
