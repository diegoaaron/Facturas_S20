<?xml version="1.0" encoding="utf-8"?>
<!-- Una factura en «Últimas facturas» de P04: inicial del proveedor, razón social, serie-número · fecha e importe. -->
<com.google.android.material.card.MaterialCardView
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp">

    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="72dp"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="16dp"
            android:paddingBottom="12dp">

        <TextView
                android:id="@+id/texto_inicial"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/fondo_inicial"
                android:gravity="center"
                android:importantForAccessibility="no"
                android:textAppearance="@style/Texto.FacturasS20.Dato"
                android:textColor="@color/color_primario"
                android:textSize="18sp"
                android:textStyle="bold"
                tools:text="D"/>

        <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

            <TextView
                    android:id="@+id/texto_proveedor"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAppearance="@style/Texto.FacturasS20.Dato"
                    android:textStyle="bold"
                    tools:text="Distribuidora Andina S.A.C."/>

            <TextView
                    android:id="@+id/texto_documento"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textAppearance="@style/Texto.FacturasS20.Secundario"
                    tools:text="F001-004821 · 22/09"/>
        </LinearLayout>

        <TextView
                android:id="@+id/texto_importe"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textAppearance="@style/Texto.FacturasS20.Dato"
                android:textStyle="bold"
                tools:text="S/ 1 450,00"/>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
