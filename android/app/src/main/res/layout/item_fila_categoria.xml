<?xml version="1.0" encoding="utf-8"?>
<!-- Una categoría en la tabla del NRUS de P14: «Cat. 1 · hasta S/ 5 000 · S/ 20». -->
<LinearLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="48dp"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="10dp">

    <TextView
            android:id="@+id/texto_codigo"
            android:layout_width="72dp"
            android:layout_height="wrap_content"
            android:textAppearance="@style/Texto.FacturasS20.Dato"
            android:textStyle="bold"
            tools:text="Cat. 1"/>

    <TextView
            android:id="@+id/texto_limite"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textAppearance="@style/Texto.FacturasS20.Dato"
            tools:text="hasta S/ 5 000"/>

    <TextView
            android:id="@+id/texto_cuota"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/Texto.FacturasS20.Dato"
            android:textStyle="bold"
            tools:text="S/ 20"/>
</LinearLayout>
