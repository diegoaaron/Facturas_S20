<?xml version="1.0" encoding="utf-8"?>
<!-- P20 Exportar datos (prototipo pantalla_20_exportar_datos.png): período, contenido, tamaño estimado,
     aviso de que el archivo no va cifrado y las acciones. -->
<LinearLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/color_fondo"
        android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/barra"
            style="@style/Widget.FacturasS20.BarraSuperior.Atras"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:subtitle="@string/exportar_subtitulo"
            app:title="@string/exportar_titulo"/>

    <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/margen">

            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/fondo_nota"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/relleno_tarjeta">

                <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_documento"
                        app:tint="@color/color_primario"/>

                <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:text="@string/exportar_explicacion"
                        android:textAppearance="@style/Texto.FacturasS20.Dato"/>
            </LinearLayout>

            <TextView
                    android:id="@+id/texto_sin_datos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:gravity="center"
                    android:text="@string/exportar_sin_datos"
                    android:textAppearance="@style/Texto.FacturasS20.Dato"
                    android:visibility="gone"/>

            <LinearLayout
                    android:id="@+id/contenido"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    tools:visibility="visible">

                <TextView
                        style="@style/Texto.FacturasS20.Seccion"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_marginTop="20dp"
                        android:accessibilityHeading="true"
                        android:text="@string/exportar_periodo"/>

                <com.google.android.material.button.MaterialButtonToggleGroup
                        android:id="@+id/alcance"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        app:checkedButton="@id/opcion_mes"
                        app:selectionRequired="true"
                        app:singleSelection="true">

                    <com.google.android.material.button.MaterialButton
                            android:id="@+id/opcion_mes"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:minHeight="@dimen/boton_grande_alto"
                            android:text="@string/exportar_un_mes"
                            android:textSize="@dimen/texto_dato"/>

                    <com.google.android.material.button.MaterialButton
                            android:id="@+id/opcion_anio"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:minHeight="@dimen/boton_grande_alto"
                            android:text="@string/exportar_todo_anio"
                            android:textSize="@dimen/texto_dato"/>
                </com.google.android.material.button.MaterialButtonToggleGroup>

                <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/campo_periodo"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:hint="@string/exportar_mes"
                        app:boxCornerRadiusBottomEnd="@dimen/radio_tarjeta"
                        app:boxCornerRadiusBottomStart="@dimen/radio_tarjeta"
                        app:boxCornerRadiusTopEnd="@dimen/radio_tarjeta"
                        app:boxCornerRadiusTopStart="@dimen/radio_tarjeta">

                    <AutoCompleteTextView
                            android:id="@+id/lista_periodos"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="none"
                            tools:ignore="LabelFor"
                            android:minHeight="@dimen/campo_alto"
                            android:textSize="18sp"
                            android:textStyle="bold"/>
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                        style="@style/Texto.FacturasS20.Seccion"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_marginTop="20dp"
                        android:accessibilityHeading="true"
                        android:text="@string/exportar_contenido"/>

                <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp">

                    <LinearLayout
                            android:id="@+id/opciones"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"/>
                </com.google.android.material.card.MaterialCardView>

                <TextView
                        android:id="@+id/texto_archivo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center"
                        android:textAppearance="@style/Texto.FacturasS20.Secundario"
                        tools:text="facturas_s20_2026-09.zip · ≈ 2,1 MB"/>

                <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/fondo_aviso"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="@dimen/relleno_tarjeta">

                    <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_alerta"
                            app:tint="@color/color_alerta_oscuro"/>

                    <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_weight="1"
                            android:text="@string/exportar_aviso_cifrado"
                            android:textAppearance="@style/Texto.FacturasS20.Dato"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/margen"
            android:paddingEnd="@dimen/margen"
            android:paddingBottom="8dp">

        <com.google.android.material.button.MaterialButton
                android:id="@+id/boton_guardar"
                style="@style/Widget.FacturasS20.Boton.Grande"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/exportar_guardar"
                app:icon="@drawable/ic_descargar"
                app:iconGravity="textStart"
                app:iconPadding="12dp"/>

        <com.google.android.material.button.MaterialButton
                android:id="@+id/boton_compartir"
                style="@style/Widget.FacturasS20.Boton.Contorno"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/exportar_compartir"
                app:icon="@drawable/ic_compartir"/>

        <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="@string/exportar_sin_servidor"
                android:textAppearance="@style/Texto.FacturasS20.Ayuda"/>
    </LinearLayout>
</LinearLayout>
