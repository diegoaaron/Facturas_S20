<?xml version="1.0" encoding="utf-8"?>
<!-- P12 Detalle y anulación (prototipo pantalla_12_detalle_y_anulacion.png): foto, datos y «Anular». -->
<LinearLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/color_fondo"
        android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/barra"
            style="@style/Widget.FacturasS20.BarraSuperior.Atras"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:menu="@menu/menu_detalle_factura"
            app:title="@string/p12_titulo"/>

    <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

        <androidx.core.widget.NestedScrollView
                android:id="@+id/desplazamiento"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="invisible"
                tools:visibility="visible">

            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/margen">

                <LinearLayout
                        android:id="@+id/aviso_anulada"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:background="@drawable/fondo_tarjeta_error"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="@dimen/relleno_tarjeta"
                        android:visibility="gone"
                        tools:visibility="visible">

                    <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_papelera"
                            app:tint="@color/color_error"/>

                    <TextView
                            android:id="@+id/texto_anulada"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:textAppearance="@style/Texto.FacturasS20.Dato"
                            android:textColor="@color/color_error"
                            tools:text="Anulada: Registrada por error. Ya no suma al total del mes."/>
                </LinearLayout>

                <FrameLayout
                        android:id="@+id/marco_imagen"
                        android:layout_width="match_parent"
                        android:layout_height="180dp"
                        android:background="@drawable/fondo_imagen_factura">

                    <ImageView
                            android:id="@+id/imagen"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="@string/foto_factura"
                            android:padding="6dp"
                            android:scaleType="fitCenter"/>

                    <TextView
                            android:id="@+id/texto_sin_foto"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:text="@string/detalle_sin_foto"
                            android:textAppearance="@style/Texto.FacturasS20.Secundario"
                            android:textColor="@color/color_camara_texto"
                            android:visibility="gone"/>
                </FrameLayout>

                <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp">

                    <LinearLayout
                            android:id="@+id/lista_datos"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:paddingStart="@dimen/relleno_tarjeta"
                            android:paddingTop="8dp"
                            android:paddingEnd="@dimen/relleno_tarjeta"
                            android:paddingBottom="8dp"/>
                </com.google.android.material.card.MaterialCardView>

                <TextView
                        android:id="@+id/texto_mes_cerrado"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/detalle_mes_cerrado"
                        android:textAppearance="@style/Texto.FacturasS20.Secundario"
                        android:visibility="gone"/>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/progreso"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:indeterminate="true"
                android:visibility="gone"
                app:indicatorColor="@color/color_primario"/>
    </FrameLayout>

    <com.google.android.material.button.MaterialButton
            android:id="@+id/boton_anular"
            style="@style/Widget.FacturasS20.Boton.Contorno.Error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margen"
            android:layout_marginEnd="@dimen/margen"
            android:layout_marginBottom="12dp"
            android:text="@string/detalle_anular"
            android:visibility="gone"
            app:icon="@drawable/ic_papelera"
            tools:visibility="visible"/>
</LinearLayout>
