<?xml version="1.0" encoding="utf-8"?>
<!-- Una fila «etiqueta ··· valor» de las tarjetas de datos (P12, P16). -->
<LinearLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="44dp"
        android:orientation="horizontal">

    <TextView
            android:id="@+id/texto_etiqueta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/Texto.FacturasS20.Secundario"
            tools:text="Proveedor"/>

    <TextView
            android:id="@+id/texto_valor"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:gravity="end"
            android:textAppearance="@style/Texto.FacturasS20.Dato"
            android:textStyle="bold"
            tools:text="Comercial Lima Norte S.A.C."/>
</LinearLayout>
