<?xml version="1.0" encoding="utf-8"?>
<!-- P09 Duplicado (prototipo pantalla_09_aviso_de_duplicado.png). -->
<LinearLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="@dimen/margen_amplio"
        android:paddingTop="28dp"
        android:paddingEnd="@dimen/margen_amplio"
        android:paddingBottom="12dp">

    <ImageView
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:background="@drawable/fondo_circulo_alerta_claro"
            android:importantForAccessibility="no"
            android:padding="18dp"
            android:src="@drawable/ic_alerta"
            app:tint="@color/color_alerta"/>

    <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:accessibilityHeading="true"
            android:gravity="center"
            android:text="@string/duplicado_titulo"
            android:textAppearance="@style/Texto.FacturasS20.Titulo"
            android:textSize="22sp"/>

    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/fondo_nota"
            android:orientation="vertical"
            android:padding="@dimen/relleno_tarjeta">

        <TextView
                android:id="@+id/texto_documento"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/Texto.FacturasS20.Dato"
                android:textStyle="bold"
                tools:text="F001-004821 · Distribuidora Andina"/>

        <TextView
                android:id="@+id/texto_detalle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textAppearance="@style/Texto.FacturasS20.Secundario"
                tools:text="Emitida el 22/09/2026 · S/ 1,450.00"/>

        <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/duplicado_criterio"
                android:textAppearance="@style/Texto.FacturasS20.Ayuda"/>
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
            android:id="@+id/boton_ver"
            style="@style/Widget.FacturasS20.Boton.Grande"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/duplicado_ver"/>

    <com.google.android.material.button.MaterialButton
            android:id="@+id/boton_descartar"
            style="@style/Widget.FacturasS20.Boton.Texto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            tools:text="@string/duplicado_descartar_foto"/>
</LinearLayout>
