<?xml version="1.0" encoding="utf-8"?>
<!-- P13 Ventas del mes (prototipo pantalla_13_ventas_del_mes.png): explicación, el total que se va
     escribiendo, las compras como referencia y un teclado propio (no el del sistema) para escribir montos. -->
<LinearLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/color_fondo"
        android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/barra"
            style="@style/Widget.FacturasS20.BarraSuperior.Atras"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            tools:title="Ventas de septiembre"/>

    <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="@dimen/margen">

            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/fondo_nota"
                    android:orientation="horizontal"
                    android:padding="@dimen/relleno_tarjeta">

                <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_mes"
                        app:tint="@color/color_primario"/>

                <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                    <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/ventas_explicacion"
                            android:textAppearance="@style/Texto.FacturasS20.Dato"/>

                    <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="@string/ventas_solo_total"
                            android:textAppearance="@style/Texto.FacturasS20.Dato"
                            android:textStyle="bold"/>
                </LinearLayout>
            </LinearLayout>

            <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/ventas_total"
                    android:textAppearance="@style/Texto.FacturasS20.Secundario"/>

            <TextView
                    android:id="@+id/texto_monto"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:accessibilityLiveRegion="polite"
                    android:textAppearance="@style/Texto.FacturasS20.Monto"
                    android:textSize="40sp"
                    tools:text="S/ 3 900,00"/>

            <View
                    android:layout_width="220dp"
                    android:layout_height="3dp"
                    android:layout_marginTop="4dp"
                    android:background="@color/color_acento"/>

            <TextView
                    android:id="@+id/texto_compras"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:textAppearance="@style/Texto.FacturasS20.Secundario"
                    tools:text="Compras registradas: S/ 4 120,50"/>

            <GridLayout
                    android:id="@+id/teclado"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:columnCount="3"
                    tools:ignore="HardcodedText">

                <TextView
                        android:id="@+id/tecla_1"
                        android:layout_width="0dp"
                        android:layout_height="60dp"
                        android:layout_columnWeight="1"
                        android:layout_margin="5dp"
                        android:background="@drawable/fondo_tecla_monto"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="1"
                        android:textColor="@color/color_texto"
                        android:textSize="26sp"/>

                <TextView
                        android:id="@+id/tecla_2"
                        android:layout_width="0dp"
                        android:layout_height="60dp"
                        android:layout_columnWeight="1"
                        android:layout_margin="5dp"
                        android:background="@drawable/fondo_tecla_monto"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="2"
                        android:textColor="@color/color_texto"
                        android:textSize="26sp"/>

                <TextView
                        android:id="@+id/tecla_3"
                        android:layout_width="0dp"
                        android:layout_height="60dp"
                        android:layout_columnWeight="1"
                        android:layout_margin="5dp"
                        android:background="@drawable/fondo_tecla_monto"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="3"
                        android:textColor="@color/color_texto"
                        android:textSize="26sp"/>

                <TextView
                        android:id="@+id/tecla_4"
                        android:layout_width="0dp"
                        android:layout_height="60dp"
                        android:layout_columnWeight="1"
                        android:layout_margin="5dp"
                        android:background="@drawable/fondo_tecla_monto"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="4"
                        android:textColor="@color/color_texto"
                        android:textSize="26sp"/>

                <TextView
                        android:id="@+id/tecla_5"
                        android:layout_width="0dp"
                        android:layout_height="60dp"
                        android:layout_columnWeight="1"
                        android:layout_margin="5dp"
                        android:background="@drawable/fondo_tecla_monto"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="5"
                        android:textColor="@color/color_texto"
                        android:textSize="26sp"/>

                <TextView
                        android:id="@+id/tecla_6"
                        android:layout_width="0dp"
                        android:layout_height="60dp"
                        android:layout_columnWeight="1"
                        android:layout_margin="5dp"
                        android:background="@drawable/fondo_tecla_monto"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="6"
                        android:textColor="@color/color_texto"
                        android:textSize="26sp"/>

                <TextView
                        android:id="@+id/tecla_7"
                        android:layout_width="0dp"
                        android:layout_height="60dp"
                        android:layout_columnWeight="1"
                        android:layout_margin="5dp"
                        android:background="@drawable/fondo_tecla_monto"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="7"
                        android:textColor="@color/color_texto"
                        android:textSize="26sp"/>

                <TextView
                        android:id="@+id/tecla_8"
                        android:layout_width="0dp"
                        android:layout_height="60dp"
                        android:layout_columnWeight="1"
                        android:layout_margin="5dp"
                        android:background="@drawable/fondo_tecla_monto"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="8"
                        android:textColor="@color/color_texto"
                        android:textSize="26sp"/>

                <TextView
                        android:id="@+id/tecla_9"
                        android:layout_width="0dp"
                        android:layout_height="60dp"
                        android:layout_columnWeight="1"
                        android:layout_margin="5dp"
                        android:background="@drawable/fondo_tecla_monto"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="9"
                        android:textColor="@color/color_texto"
                        android:textSize="26sp"/>

                <TextView
                        android:id="@+id/tecla_coma"
                        android:layout_width="0dp"
                        android:layout_height="60dp"
                        android:layout_columnWeight="1"
                        android:layout_margin="5dp"
                        android:background="@drawable/fondo_tecla_monto"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:text=","
                        android:textColor="@color/color_texto"
                        android:textSize="26sp"/>

                <TextView
                        android:id="@+id/tecla_0"
                        android:layout_width="0dp"
                        android:layout_height="60dp"
                        android:layout_columnWeight="1"
                        android:layout_margin="5dp"
                        android:background="@drawable/fondo_tecla_monto"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="0"
                        android:textColor="@color/color_texto"
                        android:textSize="26sp"/>

                <ImageView
                        android:id="@+id/tecla_borrar"
                        android:layout_width="0dp"
                        android:layout_height="60dp"
                        android:layout_columnWeight="1"
                        android:layout_margin="5dp"
                        android:background="@drawable/fondo_tecla_monto"
                        android:clickable="true"
                        android:contentDescription="@string/pin_borrar"
                        android:focusable="true"
                        android:padding="16dp"
                        android:src="@drawable/ic_borrar"
                        app:tint="@color/color_texto"/>
            </GridLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/margen"
            android:paddingEnd="@dimen/margen"
            android:paddingBottom="12dp">

        <com.google.android.material.button.MaterialButton
                android:id="@+id/boton_guardar"
                style="@style/Widget.FacturasS20.Boton.Grande"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/ventas_guardar"/>

        <TextView
                android:id="@+id/texto_ayuda"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="@string/ventas_hasta_cerrar"
                android:textAppearance="@style/Texto.FacturasS20.Secundario"/>
    </LinearLayout>
</LinearLayout>
