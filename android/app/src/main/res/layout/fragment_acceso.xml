<?xml version="1.0" encoding="utf-8"?>
<!-- P02 Acceso con PIN o huella (prototipo pantalla_02_acceso_con_pin.png). -->
<ScrollView
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/color_primario"
        android:fillViewport="true">

    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="@dimen/margen_amplio"
            android:paddingTop="40dp"
            android:paddingEnd="@dimen/margen_amplio"
            android:paddingBottom="24dp">

        <FrameLayout
                android:layout_width="@dimen/marca_diametro"
                android:layout_height="@dimen/marca_diametro"
                android:background="@drawable/fondo_circulo_borde_claro">

            <ImageView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_marca"/>
        </FrameLayout>

        <TextView
                android:id="@+id/texto_saludo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:textAppearance="@style/Texto.FacturasS20.TituloGrande"
                android:textColor="@color/color_superficie"
                android:accessibilityHeading="true"/>

        <TextView
                android:id="@+id/texto_instruccion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:textAppearance="@style/Texto.FacturasS20.Dato"
                android:textColor="@color/color_texto_sobre_primario"/>

        <pe.facturass20.ui.acceso.TecladoPin
                android:id="@+id/teclado"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                app:sobreOscuro="true"/>

        <TextView
                android:id="@+id/texto_aviso"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:accessibilityLiveRegion="polite"
                android:gravity="center"
                android:minHeight="24dp"
                android:textAppearance="@style/Texto.FacturasS20.Dato"
                android:textColor="@color/color_alerta_sobre_primario"/>

        <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:minHeight="16dp"/>

        <com.google.android.material.button.MaterialButton
                android:id="@+id/boton_huella"
                style="@style/Widget.FacturasS20.Boton.ContornoClaro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="32dp"
                android:layout_marginEnd="32dp"
                android:text="@string/p02_huella"
                android:visibility="gone"
                app:icon="@drawable/ic_huella"/>

        <com.google.android.material.button.MaterialButton
                android:id="@+id/boton_restablecer"
                style="@style/Widget.FacturasS20.Boton.Texto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/p02_olvido"
                android:textColor="@color/color_texto_sobre_primario"
                android:textStyle="normal"/>
    </LinearLayout>
</ScrollView>
