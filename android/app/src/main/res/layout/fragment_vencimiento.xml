<?xml version="1.0" encoding="utf-8"?>
<!-- P15 Vencimiento (prototipo pantalla_15_vencimiento_y_recordatorio.png): fecha límite, calendario del
     mes en que vence, de dónde sale la fecha y los recordatorios. -->
<LinearLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/color_fondo"
        android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/barra"
            style="@style/Widget.FacturasS20.BarraSuperior.Atras"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:title="@string/p15_titulo"/>

    <androidx.core.widget.NestedScrollView
            android:id="@+id/desplazamiento"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:visibility="invisible"
            tools:visibility="visible">

        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/margen">

            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/fondo_aviso"
                    android:orientation="horizontal"
                    android:padding="20dp">

                <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_calendario"
                        app:tint="@color/color_alerta_oscuro"/>

                <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                    <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/vencimiento_declare"
                            android:textAppearance="@style/Texto.FacturasS20.Secundario"/>

                    <TextView
                            android:id="@+id/texto_fecha"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textAppearance="@style/Texto.FacturasS20.Titulo"
                            android:textSize="24sp"
                            tools:text="Jueves 15 de octubre"/>

                    <TextView
                            android:id="@+id/texto_dias"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:textAppearance="@style/Texto.FacturasS20.Dato"
                            android:textColor="@color/color_alerta_oscuro"
                            android:textStyle="bold"
                            tools:text="Faltan 18 días"/>
                </LinearLayout>
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp">

                <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/relleno_tarjeta">

                    <TextView
                            android:id="@+id/texto_mes_calendario"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/Texto.FacturasS20.Dato"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            tools:text="Octubre 2026"/>

                    <GridLayout
                            android:id="@+id/calendario"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:columnCount="7"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                    android:id="@+id/texto_digito"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/fondo_nota"
                    android:padding="@dimen/relleno_tarjeta"
                    android:textAppearance="@style/Texto.FacturasS20.Dato"
                    tools:text="La fecha depende del último dígito de su RUC (4) según el cronograma de la SUNAT."/>

            <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:accessibilityHeading="true"
                    android:text="@string/vencimiento_recordatorios"
                    android:textAppearance="@style/Texto.FacturasS20.Dato"
                    android:textStyle="bold"/>

            <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp">

                <LinearLayout
                        android:id="@+id/recordatorios"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"/>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.button.MaterialButton
            android:id="@+id/boton_reporte"
            style="@style/Widget.FacturasS20.Boton.Contorno"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margen"
            android:layout_marginEnd="@dimen/margen"
            android:layout_marginBottom="12dp"
            android:text="@string/vencimiento_ver_reporte"/>
</LinearLayout>
