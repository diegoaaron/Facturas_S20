<resources>
    <!-- Tema de la app. El diseño es solo claro (documentación técnica §8.3), por eso no hay values-night. -->
    <style name="Base.Theme.FacturasS20" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/color_primario</item>
        <item name="colorOnPrimary">@color/color_superficie</item>
        <item name="colorPrimaryContainer">@color/color_ok_claro</item>
        <item name="colorOnPrimaryContainer">@color/color_primario</item>
        <item name="colorSecondary">@color/color_acento</item>
        <item name="colorOnSecondary">@color/color_primario</item>
        <item name="colorSecondaryContainer">@color/color_ok_claro</item>
        <item name="colorOnSecondaryContainer">@color/color_acento_oscuro</item>
        <item name="colorError">@color/color_error</item>
        <item name="colorErrorContainer">@color/color_error_claro</item>
        <item name="colorSurface">@color/color_superficie</item>
        <item name="colorOnSurface">@color/color_texto</item>
        <item name="colorOnSurfaceVariant">@color/color_texto2</item>
        <item name="colorOutline">@color/color_borde</item>
        <item name="android:colorBackground">@color/color_fondo</item>
        <item name="android:windowLightStatusBar">false</item>

        <item name="shapeAppearanceCornerMedium">@style/Forma.FacturasS20.Tarjeta</item>
        <item name="materialButtonStyle">@style/Widget.FacturasS20.Boton</item>
        <item name="materialCardViewStyle">@style/Widget.FacturasS20.Tarjeta</item>
        <item name="textInputStyle">@style/Widget.FacturasS20.Campo</item>
    </style>

    <style name="Theme.FacturasS20" parent="Base.Theme.FacturasS20"/>

    <!-- Pantalla de arranque: se ve mientras se consulta si la app ya está configurada (ui.acceso.Sesion). -->
    <style name="Theme.FacturasS20.Arranque" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/color_primario</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.FacturasS20</item>
    </style>

    <!-- Formas -->
    <style name="Forma.FacturasS20.Tarjeta" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radio_tarjeta</item>
    </style>

    <style name="Forma.FacturasS20.Circulo" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="Forma.FacturasS20.Boton" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radio_boton</item>
    </style>

    <!-- Componentes -->
    <style name="Widget.FacturasS20.Boton" parent="Widget.Material3.Button">
        <item name="android:minHeight">@dimen/boton_alto</item>
        <item name="android:textSize">@dimen/texto_dato</item>
        <item name="shapeAppearance">@style/Forma.FacturasS20.Boton</item>
    </style>

    <!-- Botón principal alto y en negrita: «Continuar» de P01. -->
    <style name="Widget.FacturasS20.Boton.Grande">
        <item name="android:minHeight">@dimen/boton_grande_alto</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.FacturasS20.Boton.Texto" parent="Widget.Material3.Button.TextButton">
        <item name="android:minHeight">@dimen/boton_alto</item>
        <item name="android:textSize">@dimen/texto_dato</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/color_primario</item>
    </style>

    <!-- Botón con borde de acento sobre el color primario: «Ingresar con huella» de P02. -->
    <style name="Widget.FacturasS20.Boton.ContornoClaro" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">@dimen/boton_grande_alto</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/color_acento</item>
        <item name="iconTint">@color/color_acento</item>
        <item name="iconGravity">textStart</item>
        <item name="strokeColor">@color/color_acento</item>
        <item name="strokeWidth">2dp</item>
        <item name="rippleColor">@color/color_tecla_oscura_pulsada</item>
        <item name="shapeAppearance">@style/Forma.FacturasS20.Boton</item>
    </style>

    <!-- Campo de texto con borde y esquinas de tarjeta (P01, P08, P19). -->
    <style name="Widget.FacturasS20.Campo" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">@dimen/radio_tarjeta</item>
        <item name="boxCornerRadiusTopEnd">@dimen/radio_tarjeta</item>
        <item name="boxCornerRadiusBottomStart">@dimen/radio_tarjeta</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/radio_tarjeta</item>
        <item name="boxStrokeColor">@color/campo_borde</item>
        <item name="boxStrokeWidth">1.5dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="hintTextColor">@color/color_primario</item>
        <item name="helperTextTextColor">@color/color_ok</item>
        <item name="materialThemeOverlay">@style/ThemeOverlay.FacturasS20.Campo</item>
    </style>

    <style name="ThemeOverlay.FacturasS20.Campo" parent="">
        <item name="editTextStyle">@style/Widget.FacturasS20.Campo.Texto</item>
    </style>

    <style name="Widget.FacturasS20.Campo.Texto" parent="Widget.Material3.TextInputEditText.OutlinedBox">
        <item name="android:minHeight">@dimen/campo_alto</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/color_texto</item>
    </style>

    <style name="Widget.FacturasS20.Tarjeta" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/color_superficie</item>
        <item name="strokeColor">@color/color_borde</item>
        <item name="shapeAppearance">@style/Forma.FacturasS20.Tarjeta</item>
    </style>

    <style name="Widget.FacturasS20.BarraInferior" parent="Widget.Material3.BottomNavigationView">
        <item name="android:background">@color/color_superficie</item>
        <item name="itemIconTint">@color/barra_inferior_item</item>
        <item name="itemTextColor">@color/barra_inferior_item</item>
        <item name="itemActiveIndicatorStyle">@null</item>
        <item name="labelVisibilityMode">labeled</item>
    </style>

    <!-- Tipografía (títulos 18–22 sp, montos 28–36 sp, datos 16 sp, ayuda 12 sp) -->
    <style name="Texto.FacturasS20.Titulo" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">@dimen/texto_titulo</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/color_texto</item>
    </style>

    <!-- Títulos principales: «Configure su negocio», «Septiembre 2026». -->
    <style name="Texto.FacturasS20.TituloGrande" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textSize">@dimen/texto_titulo_grande</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/color_primario</item>
    </style>

    <style name="Texto.FacturasS20.Monto" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:textSize">@dimen/texto_monto</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/color_primario</item>
    </style>

    <style name="Texto.FacturasS20.Dato" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textSize">@dimen/texto_dato</item>
        <item name="android:textColor">@color/color_texto</item>
    </style>

    <!-- Etiquetas y líneas de apoyo de las tarjetas: «Compras del mes», «F001-004821 · 22/09». -->
    <style name="Texto.FacturasS20.Secundario" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">@dimen/texto_dato</item>
        <item name="android:textColor">@color/color_texto2</item>
    </style>

    <style name="Texto.FacturasS20.Etiqueta" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textSize">@dimen/texto_secundario</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Texto.FacturasS20.Ayuda" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">@dimen/texto_ayuda</item>
        <item name="android:textColor">@color/color_texto2</item>
    </style>
</resources>
